# Copy to .env and fill in. Keep .env out of git.

# Pin a current stable tag from https://hub.docker.com/r/metabase/metabase/tags
METABASE_VERSION=v0.52.4

# Name you'll browse to (DNS record pointing at this VM)
VM_HOSTNAME=metabase.syedaq.local

# Postgres admin (used by the loader and for Metabase's own settings database)
PG_ADMIN_USER=finance_admin
PG_ADMIN_PASSWORD=change-me-long-random

# Read-only login you give Metabase for the "finance" database
PG_READER_PASSWORD=change-me-too
